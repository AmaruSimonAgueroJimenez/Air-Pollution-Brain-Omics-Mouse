^SERIES = GSE93967
!Series_title = MicroRNA microarray of mouse in response to atmospheric PM2.5 inhalation
!Series_geo_accession = GSE93967
!Series_status = Public on Jan 24 2017
!Series_submission_date = Jan 23 2017
!Series_last_update_date = Aug 02 2019
!Series_pubmed_id = 28851397
!Series_summary = To determine the epigenetic mechanism by which PM2.5 deteriorated synaptic transmission and spatial learning and memory, we determined miRNA expression in hippocampi of mice in absent or present of PM2.5 exposure using GenoExplorer microRNA microarray analysis.
!Series_overall_design = MiRNA expression in hippocampi of mice was determined after mice received oropharyngeal aspiration of saline and PM2.5 at 1 and 5 mg/kg every other day for 4 weeks. Three independent experiments were performed with three repliactes in each groups.
!Series_type = Non-coding RNA profiling by array
