^SAMPLE = GSM2465794
!Sample_title = Hippocampus-PM2.5_5 mg/kg_rep3
!Sample_geo_accession = GSM2465794
!Sample_status = Public on Jan 24 2017
!Sample_submission_date = Jan 23 2017
!Sample_last_update_date = Jan 24 2017
!Sample_type = RNA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Hippocampus,PM2.5, 5 mg/kg,replicate3
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: Hippocampus
!Sample_characteristics_ch1 = gender: male
!Sample_characteristics_ch1 = treatment: PM2.5 at 5 mg/kg exposure
!Sample_treatment_protocol_ch1 = MiRNA expression in hippocampi of mice was determined after mice received oropharyngeal aspiration of saline and PM2.5 at 1 and 5 mg/kg every other day for 4 weeks
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was extracted and purified using mirVana™ miRNA Isolation Kit (Cat#AM1560, Ambion, Austin, TX, US) | mirVanaTM PARISTM (Cat#AM1556, Ambion, Austin, TX, US) following the manufacturer’s instructions and checked for a RIN number to inspect RNA integration by an Agilent Bioanalyzer 2100 (Agilent technologies, Santa Clara, CA, US)
!Sample_label_ch1 = Cy3
!Sample_label_protocol_ch1 = miRNA molecular in total RNA was labeled by miRNA Complete Labeling and Hyb, Kit(Cat#5190‐0456, Agilent technologies, Santa Clara, CA, US)followed the manufacturer’s instructions, labeling section.
!Sample_hyb_protocol = Each slide was hybridized with 100ng Cy3‐labeled RNA using miRNA Complete Labeling and Hyb Kit(Cat#5190‐0456, Agilent technologies, Santa Clara, CA, US)in hybridization Oven(Cat#G2545A, Agilent technologies, Santa Clara, CA, US)at 55 ℃， 20rpm for 20 hours according to the manufacturer’s instructions, hybridization section. After hybridization, slides were washed in staining dishes (Cat#121, Thermo Shandon, Waltham, MA, US) with Gene Expression Wash Buffer Kit(Cat#5188‐5327, Agilent technologies, Santa Clara, CA, US).
!Sample_scan_protocol = Slides were scanned by Agilent Microarray Scanner(Cat#G2565BA，Agilent technologies, Santa Clara, CA, US).
