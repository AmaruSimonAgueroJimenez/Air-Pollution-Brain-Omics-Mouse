{
  "accno" : "E-MTAB-14917",
  "attributes" : [ {
    "name" : "Title",
    "value" : "Age- and ApoE genotype-dependent transcriptomic responses to O3 in the hippocampus of mice"
  }, {
    "name" : "ReleaseDate",
    "value" : "2025-03-20"
  }, {
